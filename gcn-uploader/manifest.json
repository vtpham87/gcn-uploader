{
  "manifest_version": 3,
  "name": "GCNDT Photos Uploader",
  "version": "1.01",
  "author": "FYJ",
  "description": "Tự động upload ảnh lên hệ thống quản lý giấy chứng nhận đăng kiểm - lọc 'bs', chống trùng tên theo ngày",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://quantrigcn.vr.org.vn/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://quantrigcn.vr.org.vn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}